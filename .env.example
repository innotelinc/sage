# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible endpoint. Examples:
#   https://api.openai.com/v1        (OpenAI: needs a paid key, supports vision + whisper)
#   https://api.groq.com/openai/v1   (Groq: fast, cheap; set AI_VISION_MODEL to a vision model)
#   https://openrouter.ai/api/v1     (OpenRouter: one key, many models)
#   http://localhost:11434/v1        (local Ollama: free, private, any key value)
AI_BASE_URL=https://gateway.innotel.us/v1

# Sent as a Bearer token to the endpoint above.
OPENAI_API_KEY=

# Reasoning model (used when no images are attached).
AI_CHAT_MODEL=gpt-4o-mini

# Image-capable model (slides, screenshots, whiteboards, video frames).
AI_VISION_MODEL=gpt-4o-mini

# Speech-to-text model for recorded audio chunks.
AI_TRANSCRIBE_MODEL=whisper-1

# Optional: require this code from the browser before the API will answer.
# Necessary if you deploy this publicly, so strangers cannot spend your credits.
ACCESS_CODE=

# Optional TLS: when both paths are set the server speaks HTTPS on PORT instead of
# plain HTTP, which is what microphones and screen capture require off localhost.
TLS_CERT=
TLS_KEY=

# Optional local voice: Kokoro-82M on CPU (deploy/kokoro). Without it the
# browser speaks, which is what most devices do anyway.
TTS_URL=
TTS_VOICE=af_heart
TTS_SPEED=1

PORT=8787

# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are Cerulean.
# Production secrets live in Cerulean Vault (KV v2) and are resolved from vault://<mount>/<path>#<KEY> refs.
# Never commit `.env`.

# Where bought Sage session keys are claimed from.
MAGNATE_URL=https://magnate.innotel.us

# ── Operator panel (/admin) ────────────────────────────────────────────────
# Sign-in is Cerulean SSO (Authentik): register a confidential OIDC provider
# there with the redirect URI https://<your-host>/admin/callback, then set these.
CERULEAN_ISSUER=
CERULEAN_CLIENT_ID=
CERULEAN_CLIENT_SECRET=

# Signs the panel's session cookie. Any long random string; the panel refuses to
# open without it. Generate one with: openssl rand -base64 48
SAGE_ADMIN_SECRET=

# Comma-separated Cerulean addresses allowed to operate this instance.
SAGE_ADMIN_EMAILS=

# Where the panel keeps its settings; must be writable by uid 1000.
SAGE_DATA_DIR=/app/data

# ── SaaS subscriptions ────────────────────────────────────────────────────
# With STRIPE_SECRET_KEY set, the instance switches from "one access code" to
# "one account per subscriber": /account serves sign-up, checkout and the
# billing portal, and every other /api route needs a live subscription.
# Leave it empty and nothing below matters — the self-hosted path is unchanged.
STRIPE_SECRET_KEY=

# From the webhook endpoint (https://<host>/api/billing/webhook). Signed events
# are the only writer of subscription state, so an unsigned one is refused.
STRIPE_WEBHOOK_SECRET=

# Signs the subscriber session cookie. Any long random string:
#   openssl rand -base64 48
# SAGE_ADMIN_SECRET is used as a fallback, but a separate one is better: an
# operator signed in to /admin should not be signed in as a subscriber.
SAGE_SESSION_SECRET=

# Where Stripe sends the browser back to. Falls back to the request's own host.
APP_ORIGIN=https://sage.innotel.tech

# Free trial on a first subscription. 0 disables it.
TRIAL_DAYS=7

# Optional: pin prices created in the Stripe dashboard instead of sending the
# catalog price inline. Set these once a plan has subscribers.
STRIPE_PRICE_SAGE_STARTER=
STRIPE_PRICE_SAGE_SCHOLAR=
STRIPE_PRICE_SAGE_SCHOLAR_YEAR=
STRIPE_CURRENCY=usd
