# Copy to .env. Wrangler reads .env and .env.local for local development;
# both are git-ignored. On Freebuff Sites, set MINTMARK_API_KEY in Sites -> Secrets,
# or paste the key into /admin after the first deploy (a stored key wins).

# A Mintmark key for the OmniRoute gateway. Keys are sold through Magnate; the
# gateway verifies the key and routes each photo to a vision model. Server-side
# only: never in browser code, logs or commits.
MINTMARK_API_KEY=

# Optional: the gateway root. Defaults to https://gateway.innotel.us/v1
# MINTMARK_BASE_URL=https://gateway.innotel.us/v1

# Optional: model id exactly as the gateway routes it. Defaults to
# gemini/gemini-3-flash-preview. The catalogue lists more ids than the
# deployment serves, so check a new one with a real photo:
#   curl https://gateway.innotel.us/v1/models -H "Authorization: Bearer $KEY"
# MINTMARK_MODEL=gemini/gemini-3-flash-preview
