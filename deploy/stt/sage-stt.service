[Unit]
Description=Whisper speech-to-text for SAGE (CPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stt
Environment=STT_HOST=127.0.0.1
Environment=STT_PORT=8881
Environment=STT_THREADS=2
# int8 on two cores; the container has 1.2 GB, so no float32 and no workers.
Environment=STT_COMPUTE_TYPE=int8
# Two cores total and Kokoro is already using them for speech.
Environment=OMP_NUM_THREADS=2
ExecStart=/opt/stt/venv/bin/python /opt/stt/service.py
Restart=always
RestartSec=5
# A runaway clip must not take the whole box down with it.
MemoryMax=900M

[Install]
WantedBy=multi-user.target
